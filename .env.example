# Server
PORT=8080
GIN_MODE=debug

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=needly
DB_SSLMODE=disable
DB_TIMEZONE=Africa/Tripoli

# Redis (cache, Pub/Sub, rate limiting, notification history)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_me
JWT_EXPIRATION_HOURS=24

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting (Redis-backed fixed-window)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Push notifications (WebSocket delivery + Redis history)
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_WEBSOCKET_ENABLED=true
NOTIFICATIONS_HISTORY_LIMIT=50